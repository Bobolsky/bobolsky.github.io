---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import site from '../data/site.json';
import { getPage, getCaseStudies } from '../lib/content';

const home = await getPage('home');
const work = await getCaseStudies();
const h = home.data as Record<string, any>;
---
<Base description={home.data.description}>
  <section class="hero">
    <div class="container">
      <h1>{h.heroTitle}</h1>
      <p class="lead">{h.heroSubtitle}</p>
      <div class="actions">
        <a class="btn btn-primary" href="/contact/">{h.ctaPrimary}</a>
        <a class="btn btn-secondary" href="/work/">{h.ctaSecondary}</a>
      </div>
      {Array.isArray(h.trustLine) && (
        <ul class="trust" aria-label="At a glance">
          {h.trustLine.map((t: string) => <li>{t}</li>)}
        </ul>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="expertise-heading">
    <div class="container">
      <h2 id="expertise-heading">Expertise</h2>
      <p class="lead">{h.expertiseIntro}</p>
      <div class="grid grid-2">
        {h.expertise.map((e: { title: string; text: string }) => (
          <article class="card">
            <h3 class="card-title">{e.title}</h3>
            <p>{e.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="work-heading">
    <div class="container">
      <h2 id="work-heading">Selected work</h2>
      <div class="grid grid-3">
        {work.map((c) => <CaseCard item={c} />)}
      </div>
      <p><a class="link-arrow" href="/work/">See selected work</a></p>
    </div>
  </section>

  <section class="section cta-band" aria-labelledby="cta-heading">
    <div class="container narrow center">
      <h2 id="cta-heading">{h.ctaTitle}</h2>
      <p>Get in touch — <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      <p>Calendar: {site.calendarUrl ? <a href={site.calendarUrl} rel="noopener" target="_blank">Book a time<span class="visually-hidden"> (opens in a new tab)</span></a> : site.calendarLabel}</p>
      <a class="btn btn-primary" href="/contact/">{h.ctaPrimary}</a>
    </div>
  </section>
</Base>
