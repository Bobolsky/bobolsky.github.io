---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getCaseStudies } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getCaseStudies();
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

interface Props { item: CollectionEntry<'caseStudies'> }
const { item } = Astro.props;
const d = item.data;
const { Content } = await render(item);
---
<Base title={d.title} description={d.summary}>
  <article>
    <header class="page-header">
      <div class="container narrow">
        <p class="eyebrow"><a href="/work/">Case studies</a></p>
        <h1>{d.title}</h1>
        <p class="lead">{d.summary}</p>
        <dl class="meta">
          {d.context && <div><dt>Context</dt><dd>{d.context}</dd></div>}
          {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
          {d.repo && (
            <div><dt>Code</dt><dd><a href={d.repo} rel="noopener" target="_blank">{d.repo.replace('https://', '')}<span class="visually-hidden"> (opens in a new tab)</span></a></dd></div>
          )}
        </dl>
        {d.tags.length > 0 && <ul class="tags" aria-label="Technologies">{d.tags.map((t) => <li>{t}</li>)}</ul>}
      </div>
    </header>
    <div class="section">
      <div class="container narrow prose">
        <Content />
      </div>
      <div class="container narrow">
        <p><a class="link-arrow" href="/work/">Back to all case studies</a></p>
      </div>
    </div>
  </article>
</Base>
