---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getCaseStudies } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getCaseStudies();
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

interface Props { item: CollectionEntry<'caseStudies'> }
const { item } = Astro.props;
const d = item.data;
const { Content } = await render(item);
---
<Base title={d.title} description={`${d.cardTitle}. ${d.attribution}`}>
  <article>
    <header class="page-header">
      <div class="container narrow">
        <p class="eyebrow"><a href="/work/">Selected work</a></p>
        <h1>{d.title}</h1>
        <p class="lead">{d.attribution}</p>
        {d.repo && (
          <dl class="meta">
            <div><dt>Code</dt><dd><a href={d.repo} rel="noopener" target="_blank">{d.repo.replace('https://', '')}<span class="visually-hidden"> (opens in a new tab)</span></a></dd></div>
          </dl>
        )}
      </div>
    </header>
    <div class="section">
      <div class="container narrow prose">
        <Content />
      </div>
      <div class="container narrow">
        <p><a class="link-arrow" href="/work/">Back to selected work</a></p>
      </div>
    </div>
  </article>
</Base>
