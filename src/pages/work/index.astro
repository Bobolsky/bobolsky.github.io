---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import CardCredits from '../../components/CardCredits.astro';
import { getCaseStudies } from '../../lib/content';

const items = await getCaseStudies();
const intro =
  'A mix of public personal and academic projects and work done at Multiverse Computing, described only as already stated in my CV or in public sources.';
---
<Base title="Selected work" description={intro}>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Work</p>
      <h1>Selected work</h1>
      <p class="lead">{intro}</p>
    </div>
  </section>
  <section class="section section-tight">
    <div class="container">
      <div class="grid grid-3">
        {items.map((c) => <CaseCard item={c} headingLevel={2} />)}
      </div>
      <CardCredits items={items} />
    </div>
  </section>
</Base>
