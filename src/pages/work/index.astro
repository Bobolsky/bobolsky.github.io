---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { getCaseStudies } from '../../lib/content';

const items = await getCaseStudies();
---
<Base title="Work" description="Case studies from public projects by Andrea Zinno: computer vision, robotics and AI applications.">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Work</p>
      <h1>Case studies</h1>
      <p class="lead">Public projects with code on GitHub.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {items.map((c) => <CaseCard item={c} headingLevel={2} />)}
      </div>
    </div>
  </section>
</Base>
