---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getPage, getServices } from '../lib/content';

const page = await getPage('services');
const { Content } = await render(page);
const services = await getServices();
const d = page.data as Record<string, any>;
---
<Base title={page.data.title} description={page.data.description}>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h1>{d.umbrellaTitle}</h1>
      <p class="lead">{d.umbrellaText}</p>
    </div>
  </section>

  <section class="section" aria-label="Starter packages">
    <div class="container">
      <div class="grid grid-3 align-start">
        {services.map((s) => <ServiceCard service={s} detailed headingLevel={2} />)}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container narrow">
      <div class="prose"><Content /></div>
      <p><a class="btn btn-primary" href="/contact/">Book a 20-min intro</a></p>
    </div>
  </section>
</Base>
