---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookingActions from '../components/BookingActions.astro';
import site from '../data/site.json';
import { booking } from '../lib/booking';
import { getPage } from '../lib/content';

const page = await getPage('contact');
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <section class="page-header">
    <div class="container narrow">
      <h1>Contact</h1>
    </div>
  </section>
  <section class="section section-tight">
    <div class="container narrow">
      <div class="prose lead-prose"><Content /></div>

      <BookingActions contactHref={`mailto:${site.email}`} />

      <dl class="contact-list">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt>LinkedIn</dt>
          <dd><a href={site.linkedin} rel="me noopener" target="_blank">{site.linkedin}<span class="visually-hidden"> (opens in a new tab)</span></a></dd>
        </div>
        <div>
          <dt>GitHub</dt>
          <dd><a href={site.github} rel="me noopener" target="_blank">{site.github}<span class="visually-hidden"> (opens in a new tab)</span></a></dd>
        </div>
        <div>
          <dt>Site</dt>
          <dd><a href={site.url}>{site.url}</a></dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>{site.location}</dd>
        </div>
        {booking && (
          <div>
            <dt>Calendar</dt>
            <dd><a href={booking.url} rel="noopener" target="_blank">{booking.label}<span class="visually-hidden"> (opens in a new tab)</span></a></dd>
          </div>
        )}
      </dl>
    </div>
  </section>
</Base>
