---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { getPage } from '../lib/content';

const page = await getPage('contact');
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <section class="page-header">
    <div class="container narrow">
      <h1>Contact</h1>
    </div>
  </section>
  <section class="section">
    <div class="container narrow">
      <div class="prose"><Content /></div>

      <dl class="contact-list">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt>LinkedIn</dt>
          <dd><a href={site.linkedin} rel="me noopener" target="_blank">{site.linkedin}<span class="visually-hidden"> (opens in a new tab)</span></a></dd>
        </div>
        <div>
          <dt>GitHub</dt>
          <dd><a href={site.github} rel="me noopener" target="_blank">{site.github}<span class="visually-hidden"> (opens in a new tab)</span></a></dd>
        </div>
        <div>
          <dt>Site</dt>
          <dd><a href={site.url}>{site.url}</a></dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>{site.location}</dd>
        </div>
        <div>
          <dt>Calendar</dt>
          <dd>{site.calendarUrl ? <a href={site.calendarUrl} rel="noopener" target="_blank">Book a time<span class="visually-hidden"> (opens in a new tab)</span></a> : site.calendarLabel}</dd>
        </div>
      </dl>
    </div>
  </section>
</Base>
